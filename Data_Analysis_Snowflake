-- Query 24
-- join DimCustomer and DimLoyalty, and show the customer 1st name along with the program tier they are part of
with customerdata as (
select TRIM(UPPER($1)) as firstname, TRIM(UPPER($11)) as loyaltyprogramid from
@TEST_DB.TEST_DB_SCHEMA.TESTSTAGE/DimCustomerInfo/Auto_Compress=False/DimCustomerInfo.csv.gz
(FILE_FORMAT => 'CSV_SOURCE_FILE_FORMAT')),
loyaltydata as (
select TRIM(UPPER($1)) as loyaltyprogramid, TRIM(UPPER($3)) as programtier from
@TEST_DB.TEST_DB_SCHEMA.TESTSTAGE/DimLoyaltyInfo/Auto_Compress=False/DimLoyaltyInfo.csv.gz
(FILE_FORMAT => 'CSV_SOURCE_FILE_FORMAT'))
